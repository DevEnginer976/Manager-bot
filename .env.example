PORT=3000
NODE_ENV=development
BASE_URL=http://localhost:3000

# Create an OAuth2 application at https://discord.com/developers/applications
DISCORD_CLIENT_ID=YOUR_CLIENT_ID
DISCORD_CLIENT_SECRET=YOUR_CLIENT_SECRET
DISCORD_REDIRECT_URI=http://localhost:3000/auth/callback

# Generate two independent random secrets. Never commit your real .env.
SESSION_SECRET=REPLACE_WITH_LONG_RANDOM_SECRET
# Exactly 32 bytes encoded as 64 hexadecimal characters:
MASTER_ENCRYPTION_KEY=REPLACE_WITH_64_HEX_CHARACTERS

# Optional application Public Key for future Discord HTTP interactions.
# It is NOT a bot token and does not connect a bot.
DISCORD_PUBLIC_KEY=
