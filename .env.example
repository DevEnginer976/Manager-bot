PORT=3000
NODE_ENV=production
BASE_URL=https://YOUR-BACKEND-DOMAIN
FRONTEND_URL=https://YOUR-USERNAME.github.io/YOUR-REPOSITORY
ALLOWED_ORIGIN=https://YOUR-USERNAME.github.io

# OAuth2 application used for dashboard login (not the bots being connected).
DISCORD_CLIENT_ID=YOUR_DASHBOARD_CLIENT_ID
DISCORD_CLIENT_SECRET=YOUR_DASHBOARD_CLIENT_SECRET
# This callback belongs to the BACKEND domain, not GitHub Pages:
DISCORD_REDIRECT_URI=https://YOUR-BACKEND-DOMAIN/auth/callback

SESSION_SECRET=REPLACE_WITH_LONG_RANDOM_SECRET
# Exactly 32 bytes encoded as 64 hexadecimal characters:
MASTER_ENCRYPTION_KEY=REPLACE_WITH_64_HEX_CHARACTERS

# Optional Discord Interactions verification key. Not a bot token.
DISCORD_PUBLIC_KEY=
